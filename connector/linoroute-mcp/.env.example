PORT=8787
HOST=127.0.0.1
LINOROUTE_API_BASE=https://linoroute.com
MCP_PATH=/mcp
MCP_ALLOWED_HOSTS=mcp.linoroute.com,localhost,127.0.0.1
# Optional comma-separated origins. Leave empty when the MCP host does not send Origin.
MCP_ALLOWED_ORIGINS=
# Maximum media bytes fetched from an HTTPS reference URL.
MEDIA_MAX_BYTES=5242880
# Optional comma-separated hostnames for reference media. Empty means no hostname allowlist.
MEDIA_ALLOWED_HOSTS=
