# Dedicated long-lived OSS for the public image prompt library.
# Do not reuse the temporary upload bucket and do not apply a 7-day lifecycle.
STUDIO_PROMPT_OSS_ACCESS_KEY_ID=
STUDIO_PROMPT_OSS_ACCESS_KEY_SECRET=
STUDIO_PROMPT_OSS_ENDPOINT=https://oss-cn-guangzhou.aliyuncs.com
STUDIO_PROMPT_OSS_REGION=cn-guangzhou
STUDIO_PROMPT_OSS_BUCKET=replace_with_dedicated_bucket_name
STUDIO_PROMPT_OSS_PREFIX=prompt-library/images
# Optional custom domain. Leave blank to use https://<bucket>.<endpoint-host>.
STUDIO_PROMPT_OSS_PUBLIC_BASE_URL=
