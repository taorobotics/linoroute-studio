# Public upstream API used by the local development relay.
# This is a URL only. Never put an API key in this file or in VITE_* variables.
STUDIO_API_UPSTREAM=https://linoroute.com

# Optional server-side signer for the browser-to-OSS upload flow.
# Leave empty when you do not enable persistent OSS storage.
STUDIO_STORAGE_SIGNER=http://127.0.0.1:4181/v1/uploads
